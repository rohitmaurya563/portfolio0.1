# Copy this file to .env and fill in your real values. Never commit .env itself.

PORT=5000

# Where the frontend is served from (for CORS). In dev with Live Server it's usually
# something like http://127.0.0.1:5500 — check the URL Live Server opens for you.
CLIENT_ORIGIN=http://127.0.0.1:5500

# --- Email (SMTP) settings ---
# Easiest option: a Gmail account with an "App Password" (not your normal password).
# Google Account > Security > 2-Step Verification > App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# The address that should receive contact-form messages (usually the same as SMTP_USER)
CONTACT_RECEIVER=your-email@gmail.com
